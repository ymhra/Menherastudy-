<!DOCTYPE html>
<html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#12304a"><title>QR記録アプリ</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script><script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<style>
:root{--ink:#12304a;--paper:#fff;--muted:#eef3f6;--line:#cbd5dc}*{box-sizing:border-box}body{margin:0;padding:0 0 76px;background:var(--paper);color:var(--ink);font:16px -apple-system,BlinkMacSystemFont,"Helvetica Neue",sans-serif}header{padding:14px 16px;border-bottom:1px solid var(--ink);display:flex;align-items:center;gap:12px}h1{font-size:21px;margin:0;flex:1}h2{font-size:20px;margin:18px 0 12px}h3{font-size:17px;margin:10px 0}main{max-width:780px;margin:auto;padding:14px}button,input,select,textarea{font:inherit;border:1px solid var(--ink);border-radius:0;padding:10px;background:white;color:var(--ink);max-width:100%}button{cursor:pointer}button.primary{background:var(--ink);color:white}.full{width:100%;margin:5px 0}.hidden{display:none!important}.muted{background:var(--muted);padding:12px}.bottom-nav{position:fixed;bottom:0;left:0;width:100%;display:flex;background:#fff;border-top:2px solid var(--ink);z-index:10}.bottom-nav button{width:33.33%;border:0;padding:13px 3px}.bottom-nav button.active{background:var(--ink);color:white;font-weight:bold}.row{display:flex;gap:8px;align-items:center}.row>*{min-width:0}.grow{flex:1}.small{font-size:13px;color:#536777}.iconbtn{width:48px;height:48px;min-width:48px;padding:0;border:0;background:transparent;color:var(--ink);display:flex;align-items:center;justify-content:center;flex:0 0 48px;line-height:0;box-sizing:border-box;appearance:none;-webkit-appearance:none}.settings-button{aspect-ratio:1;overflow:hidden}.settings-button svg{display:block;width:30px;height:30px;flex:0 0 30px;overflow:hidden;box-sizing:border-box}.info-button{border:0;background:transparent;padding:2px 5px;color:var(--ink);font-size:19px;line-height:1}.info-popover{position:fixed;z-index:50;left:50%;top:78px;transform:translateX(-50%);width:min(320px,calc(100vw - 32px));background:#fff;border:1px solid var(--line);box-shadow:0 4px 18px #0002;padding:14px}.info-popover p{margin:8px 0 12px;font-size:14px;line-height:1.6}.info-popover button{border:0;padding:5px 0;text-decoration:underline}.hour-scroller{scroll-snap-type:x mandatory;scroll-padding-inline:calc(50% - 39px);-webkit-overflow-scrolling:touch}.hour-item{scroll-snap-align:center;flex:0 0 78px}.hour-item.active{outline:2px solid var(--ink);outline-offset:-2px}.scan-fab{position:fixed;right:18px;bottom:88px;width:58px;height:58px;border:0;border-radius:50%;background:var(--ink);color:white;z-index:8;font-size:25px}.card{border-top:1px solid var(--line);padding:13px 0}.category-management,.toolbar{display:flex;gap:7px;flex-wrap:wrap;margin:8px 0}.toolbar button{flex:1}.date-switch{display:flex;gap:8px}.date-switch button{flex:1}.date-switch button.active{background:var(--ink);color:white}.hour-scroller{display:flex;overflow-x:auto;gap:0;padding:8px 0;scroll-padding-inline:0;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain}.hour-spacer{flex:0 0 max(0px,calc(50vw - 39px));width:max(0px,calc(50vw - 39px));pointer-events:none}.hour-item{min-width:78px;text-align:center;padding:12px 6px;border:0;border-bottom:1px solid var(--line)}.hour-item.active{background:var(--ink);color:white}.timeline{border-left:2px solid var(--ink);margin:12px 0 12px 12px;padding-left:16px}.entry{position:relative;padding:10px 0}.entry:before{content:"";position:absolute;left:-22px;top:16px;width:9px;height:9px;background:var(--ink);border-radius:50%}.entry-time{font-size:14px;color:#536777}.entry-name{font-size:17px;font-weight:bold;margin-top:3px}.memo{font-size:14px;color:#536777;margin-top:5px;white-space:pre-wrap}.qr-image{margin:10px 0}.archive-item{padding:14px 8px;border-bottom:1px solid var(--line);display:flex;gap:10px;align-items:center}.archive-item span{flex:1}.path{display:flex;gap:6px;flex-wrap:wrap;margin:10px 0}.path button{flex:1}.print-choice{display:flex;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}.modal{position:fixed;inset:0;background:#0008;z-index:30;display:flex;align-items:center;justify-content:center;padding:14px}.scan-modal{padding:0!important;align-items:stretch!important;justify-content:stretch!important}.scan-modal .panel{width:100%;max-width:none;height:100vh;height:100dvh;max-height:100vh;max-height:100dvh;overflow:hidden;display:flex;flex-direction:column;padding:8px;gap:4px}.scan-modal h2{margin:4px 0 8px}.scan-modal .scan-options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}.scan-modal .scan-options button{margin:0;padding:9px 3px;font-size:14px;min-height:44px}.scan-modal #scannerArea{flex:1;min-height:0;display:flex;flex-direction:column;overflow:hidden}.scan-modal #scanVideo{width:100%;height:100%;min-height:0;object-fit:contain;flex:1}.scan-modal #scanMessage{margin:2px 0;font-size:11px;line-height:1.2;flex:0 0 auto}.scan-modal .full{margin:2px 0;padding:8px}.scan-modal .scan-options button.selected{background:var(--ink);color:white}.panel{background:white;width:100%;max-width:560px;max-height:90vh;overflow:auto;padding:18px}.panel input,.panel textarea,.panel select{width:100%;margin:5px 0}.report{border:1px solid var(--line);padding:14px;margin:12px 0}.report-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.report-list{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid var(--line)}.report-title{font-size:20px;font-weight:bold}.report-total{font-size:30px;font-weight:bold;margin:4px 0 12px}.report-duration{font-size:20px;font-weight:bold;white-space:nowrap}.report-memo{font-size:13px;color:#536777;min-height:18px;white-space:pre-wrap}.info-text{background:var(--muted);padding:12px;margin:8px 0}.danger{border-color:#8b1e1e;color:#8b1e1e}.hidden{display:none!important}
@media(max-width:560px){.report-grid{grid-template-columns:1fr}.report-duration{font-size:19px}}
@media print{body{padding:0}.bottom-nav,header,button,.no-print{display:none!important}main{max-width:none;padding:0}.report{border:0;margin:0;padding:0}}
</style></head><body>
<header><h1>QR記録アプリ</h1><button class="iconbtn settings-button" onclick="openSettings()" aria-label="設定を開く" title="設定"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5v2M12 19.5v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2.5 12h2M19.5 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2.5"/></svg></button></header><main>
<section id="currentPage"><div class="row"><h2>記録</h2><button class="info-button" onclick="showInfo('current')" title="記録の説明" aria-label="記録の説明">ⓘ</button><div class="grow"></div><button onclick="openDailyReport()" title="振り返りシート">▤</button></div>

<div class="date-switch"><button id="todayBtn" onclick="setDateOffset(0)">今日</button><button id="yesterdayBtn" onclick="setDateOffset(-1)">昨日</button></div>
<div class="row"><p id="selectedDateLabel" class="grow"></p><strong id="studyTotal"></strong></div><div id="hourScroller" class="hour-scroller"></div><div id="currentRecords"></div></section>
<section id="pastPage" class="hidden"><div class="row"><h2>過去の記録</h2><button class="info-button" onclick="showInfo('past')" aria-label="過去の記録の説明">ⓘ</button></div><div id="archivePath" class="path"></div><div id="archiveList"></div><div id="archiveDetail"></div></section>
<section id="qrPage" class="hidden"><div class="row"><h2>QRコード作成</h2><button class="info-button" onclick="showInfo('qr')" aria-label="QRコード作成の説明">ⓘ</button><div class="grow"></div><button onclick="showPastQRs()">過去のQRコード</button></div>
<input id="qrName" placeholder="QRコードの名前" class="full"><label>分類</label><div class="row"><select id="qrCategory" class="grow"></select><button onclick="openCategoryEditor()" style="white-space:nowrap">編集</button></div><button class="primary full" onclick="createQR()">作成</button><button class="full" onclick="openPrintSelection()">印刷</button><div id="printSelection" class="hidden"><h3>印刷するQRコードを選ぶ（最大10個）</h3><button class="full" onclick="selectLatest10()">最新の10個を選択する</button><div id="printChoices"></div><button class="primary full" onclick="printSelectedQRs()">選んだQRコードを印刷</button><button class="full" onclick="closePrintSelection()">戻る</button><button class="full" onclick="showPastQRs()">過去のQRコード</button></div><div id="qrList"></div></section>
<section id="qrPastPage" class="hidden"><div class="row"><h2>過去のQRコード</h2><div class="grow"></div><button onclick="backFromPastQRs()">戻る</button></div><div id="qrPastList"></div></section>
<section id="settingsPage" class="hidden"><h2>設定</h2><h3>データの管理</h3><p class="small">バックアップはJSON形式でiPhoneの「ファイル」に保存できます。</p><button class="primary full" onclick="backupData()">バックアップを作成する</button><button class="full" onclick="restoreData()">バックアップから復元する</button><input type="file" id="restoreFile" accept=".json,application/json" class="hidden" onchange="restoreFromFile(event)"><button class="full" onclick="exportExcel()">Excel形式で記録を出力する</button><button class="full" onclick="closeSettings()">閉じる</button></section>
</main><button id="scanFab" class="scan-fab" onclick="openScanMode()" aria-label="QRコードを読み取る" title="QRコードを読み取る"><svg width="29" height="29" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 7V5h2M17 5h2v2M19 17v2h-2M7 19H5v-2"/><rect x="7" y="7" width="10" height="10" rx="1"/><path d="M9 9h2v2H9zM13 9h2v2h-2zM9 13h2v2H9zM13 13h2"/></svg></button>
<nav class="bottom-nav"><button id="pastTab" onclick="switchPage('past')">過去の記録</button><button id="currentTab" class="active" onclick="switchPage('current')">記録</button><button id="qrTab" onclick="switchPage('qr')">QRコード作成</button></nav>
<div id="infoPopover" class="info-popover hidden" role="dialog" aria-live="polite"><div class="row"><strong id="infoTitle"></strong><div class="grow"></div><button onclick="closeInfo()" aria-label="閉じる">閉じる</button></div><p id="infoContent"></p></div><div id="modal" class="modal hidden"><div class="panel" id="modalPanel"></div></div>
<div id="scanModal" class="modal scan-modal hidden"><div class="panel"><h2>QRコードを読み取る</h2><div class="scan-options"><button data-scanmode="record" onclick="startScanner('record')">記録する</button><button data-scanmode="search" onclick="startScanner('search')">探す</button><button data-scanmode="edit" onclick="startScanner('edit')">名前・分類を変更</button></div><div id="scannerArea" class="hidden"><video id="scanVideo" playsinline></video><p id="scanMessage"></p></div><button class="full" onclick="closeScanner()">閉じる</button></div></div>
<script>
const DB_NAME='QRRecordDB',DB_VERSION=1,STORE='appData';let db,scanMode=null,cameraStream=null,scanLoop=null,settingsReturnPage='current',qrPastReturnPage='qr',selectedDate=new Date(),selectedHour=new Date().getHours(),archiveYear=null,archiveMonth=null,archiveWeek=null,archiveDay=null,showingPastQR=false;
const DEFAULT_CATEGORIES=['勉強','起床','就寝'];let state={qrs:[],logs:[],categories:[...DEFAULT_CATEGORIES]};
function openDB(){return new Promise((resolve,reject)=>{const req=indexedDB.open(DB_NAME,DB_VERSION);req.onupgradeneeded=()=>{const d=req.result;if(!d.objectStoreNames.contains(STORE))d.createObjectStore(STORE,{keyPath:'key'})};req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error)})}
function dbGet(key){return new Promise((resolve,reject)=>{const tx=db.transaction(STORE,'readonly'),r=tx.objectStore(STORE).get(key);r.onsuccess=()=>resolve(r.result?.value);r.onerror=()=>reject(r.error)})}
function dbSet(key,value){return new Promise((resolve,reject)=>{const tx=db.transaction(STORE,'readwrite');tx.objectStore(STORE).put({key,value});tx.oncomplete=()=>resolve();tx.onerror=()=>reject(tx.error)})}
async function initDB(){db=await openDB();let old=localStorage.getItem('qr_items');if(old&&!await dbGet('qrs')){state.qrs=JSON.parse(old||'[]');state.logs=JSON.parse(localStorage.getItem('qr_logs')||'[]');state.categories=JSON.parse(localStorage.getItem('qr_categories')||'null')||DEFAULT_CATEGORIES;await saveState();}state.qrs=await dbGet('qrs')||[];state.logs=await dbGet('logs')||[];state.categories=await dbGet('categories')||[...DEFAULT_CATEGORIES];renderCategories();openToday();renderCurrent();renderArchive();showQRs();checkURL()}
async function saveState(){await Promise.all([dbSet('qrs',state.qrs),dbSet('logs',state.logs),dbSet('categories',state.categories)])}
const dateKey=d=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;const parseDate=s=>{let [y,m,d]=s.split('-').map(Number);return new Date(y,m-1,d)};const addDays=(d,n)=>{let x=new Date(d);x.setDate(x.getDate()+n);return x};const fmtDate=d=>`${d.getFullYear()}年${d.getMonth()+1}月${d.getDate()}日`;const monthKey=d=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;
function switchPage(p){document.getElementById('qrPastPage').classList.add('hidden');['current','past','qr','settings'].forEach(x=>document.getElementById(x+'Page')?.classList.toggle('hidden',x!==p));['current','past','qr'].forEach(x=>document.getElementById(x+'Tab').classList.toggle('active',x===p));document.getElementById('scanFab').classList.toggle('hidden',p!=='current');if(p==='current')renderCurrent();if(p==='past')renderArchive();if(p==='qr')showQRs();}
function openToday(){selectedDate=new Date();selectedDate.setHours(0,0,0,0);selectedHour=new Date().getHours()}
function setDateOffset(n){selectedDate=addDays(new Date(),n);selectedDate.setHours(0,0,0,0);selectedHour=new Date().getHours();renderCurrent()}
function renderCurrent(){document.getElementById('selectedDateLabel').textContent=fmtDate(selectedDate);document.getElementById('todayBtn').classList.toggle('active',dateKey(selectedDate)===dateKey(new Date()));document.getElementById('yesterdayBtn').classList.toggle('active',dateKey(selectedDate)===dateKey(addDays(new Date(),-1)));let hs=document.getElementById('hourScroller');if(hs.querySelectorAll('.hour-item').length!==24){hs.innerHTML='';let start=document.createElement('span');start.className='hour-spacer';hs.appendChild(start);for(let h=0;h<24;h++){let b=document.createElement('button');b.className='hour-item';b.dataset.hour=h;b.textContent=h+'時';b.onclick=()=>selectHour(h,true);hs.appendChild(b)}let end=document.createElement('span');end.className='hour-spacer';hs.appendChild(end)}updateHourButtons();requestAnimationFrame(()=>{let active=hs.querySelector('.active');if(active)hs.scrollLeft=active.offsetLeft+active.offsetWidth/2-hs.clientWidth/2});renderHourRecords();document.getElementById('studyTotal').textContent='勉強 '+formatDuration(getStudyTotal(dateKey(selectedDate)));}
function updateHourButtons(){document.querySelectorAll('#hourScroller .hour-item').forEach(el=>el.classList.toggle('active',Number(el.dataset.hour)===selectedHour))}
function renderHourRecords(){let logs=state.logs.filter(x=>x.date===dateKey(selectedDate)&&new Date(x.timestamp).getHours()===selectedHour).sort((a,b)=>a.timestamp.localeCompare(b.timestamp));renderTimeline(document.getElementById('currentRecords'),logs)}
function selectHour(h,centerItem=false){selectedHour=h;updateHourButtons();renderHourRecords();if(centerItem){let item=document.querySelector(`#hourScroller .hour-item[data-hour="${h}"]`);if(item){let sc=document.getElementById('hourScroller');sc.scrollTo({left:item.offsetLeft+item.offsetWidth/2-sc.clientWidth/2,behavior:'smooth'})}}}
let hourScrollFrame=0;document.getElementById('hourScroller').addEventListener('scroll',()=>{if(hourScrollFrame)return;hourScrollFrame=requestAnimationFrame(()=>{hourScrollFrame=0;const sc=document.getElementById('hourScroller');const itemWidth=78;const spacer=Math.max(0,window.innerWidth/2-39);const centerPos=sc.scrollLeft+sc.clientWidth/2-spacer;const h=Math.max(0,Math.min(23,Math.round((centerPos-39)/itemWidth)));if(h!==selectedHour){selectedHour=h;updateHourButtons();renderHourRecords()}})},{passive:true});

function renderTimeline(el,logs){el.innerHTML='';let h=document.createElement('h3');h.textContent=selectedHour+'時';el.appendChild(h);if(!logs.length){el.append('この時間の記録はありません。');return}let tl=document.createElement('div');tl.className='timeline';logs.forEach(log=>{let e=document.createElement('div');e.className='entry';let t=document.createElement('div');t.className='entry-time';t.textContent=new Date(log.timestamp).toLocaleTimeString('ja-JP',{hour:'2-digit',minute:'2-digit'});let n=document.createElement('div');n.className='entry-name';n.textContent=`${log.name}（${log.category||'未分類'}）`;let m=document.createElement('div');m.className='memo';m.textContent=log.memo||'';let row=document.createElement('div');row.className='row';let del=document.createElement('button');del.textContent='消去する';del.onclick=async()=>{if(confirm('この記録を削除しますか？')){state.logs=state.logs.filter(x=>x.logId!==log.logId);await saveState();renderCurrent()}};row.append(del);e.append(t,n,m,row);tl.appendChild(e)});el.appendChild(tl)}
function getStudyTotal(day){let logs=state.logs.filter(x=>x.date===day).sort((a,b)=>a.timestamp.localeCompare(b.timestamp));let total=0;for(let i=0;i<logs.length;i++){if(logs[i].category==='勉強'){let next=logs.slice(i+1).find(x=>x.id!==logs[i].id);if(next){let mins=(new Date(next.timestamp)-new Date(logs[i].timestamp))/60000;if(mins>0&&mins<24*60)total+=mins}}}return Math.round(total)}function formatDuration(min){let h=Math.floor(min/60),m=Math.round(min%60);return h?`${h}時間${m?m+'分':''}`:`${m}分`}
function renderCategories(){let s=document.getElementById('qrCategory');if(!s)return;s.innerHTML='';state.categories.forEach(c=>{let o=document.createElement('option');o.value=c;o.textContent=c;s.appendChild(o)})}
function openCategoryEditor(){let p=document.getElementById('modalPanel');p.innerHTML='<h2>分類の編集</h2><div id="categoryList"></div><input id="newCat" placeholder="新しい分類名"><button class="primary full" onclick="addCat()">分類を追加</button><button class="full" onclick="closeModal()">閉じる</button>';renderCategoryEditor()}
function renderCategoryEditor(){let list=document.getElementById('categoryList');if(!list)return;list.innerHTML='';state.categories.forEach((c,i)=>{let r=document.createElement('div');r.className='row card';let t=document.createElement('span');t.textContent=c;t.className='grow';let up=document.createElement('button');up.textContent='↑';up.disabled=i===0;up.onclick=()=>moveCat(i,-1);let down=document.createElement('button');down.textContent='↓';down.disabled=i===state.categories.length-1;down.onclick=()=>moveCat(i,1);let del=document.createElement('button');del.textContent='削除';del.disabled=DEFAULT_CATEGORIES.includes(c);del.onclick=()=>{if(confirm(`分類「${c}」を削除しますか？`)){state.categories.splice(i,1);saveState();renderCategories();renderCategoryEditor()}};r.append(t,up,down,del);list.appendChild(r)})}
async function moveCat(i,d){let j=i+d;[state.categories[i],state.categories[j]]=[state.categories[j],state.categories[i]];await saveState();renderCategories();renderCategoryEditor()}
async function addCat(){let n=document.getElementById('newCat').value.trim();if(!n)return alert('分類名を入力してください');if(state.categories.includes(n))return alert('すでに存在します');state.categories.push(n);await saveState();renderCategories();renderCategoryEditor()}
function createQR(){let name=document.getElementById('qrName').value.trim();if(!name)return alert('名前を入力してください');let id=crypto.randomUUID();state.qrs.push({id,name,category:document.getElementById('qrCategory').value,createdAt:new Date().toISOString(),printed:false,deleted:false});saveState().then(()=>{document.getElementById('qrName').value='';showQRs()})}
function currentQRs(){let now=Date.now();return state.qrs.filter(q=>!q.deleted&&!q.printed&&q.createdAt&&now-new Date(q.createdAt).getTime()<3600000).sort((a,b)=>new Date(b.createdAt)-new Date(a.createdAt))}function pastQRs(){let now=Date.now();return state.qrs.filter(q=>!q.deleted&&(q.printed||!q.createdAt||now-new Date(q.createdAt).getTime()>=3600000)).sort((a,b)=>new Date(b.createdAt)-new Date(a.createdAt))}
function qrUrl(q){let u=new URL(location.href);u.search='';u.hash='';u.searchParams.set('scan',q.id);return u.href}
function showQRs(){showingPastQR=false;renderQRList(currentQRs(),'qrList','現在のQRコード')}
function showPastQRs(){showingPastQR=true;qrPastReturnPage='qr';document.getElementById('qrPage').classList.add('hidden');document.getElementById('qrPastPage').classList.remove('hidden');document.getElementById('printSelection').classList.add('hidden');renderQRList(pastQRs(),'qrPastList','過去のQRコード')}
function backFromPastQRs(){document.getElementById('qrPastPage').classList.add('hidden');document.getElementById('qrPage').classList.remove('hidden');showQRs()}
function renderQRList(items,target,title){let el=document.getElementById(target);el.innerHTML='';if(title==='過去のQRコード'){let h=document.createElement('h3');h.textContent=title;el.appendChild(h);let search=document.createElement('input');search.placeholder='名前で検索';search.className='full';let cat=document.createElement('select');cat.className='full';cat.innerHTML='<option value="">すべての分類</option>'+state.categories.map(c=>`<option>${escapeHtml(c)}</option>`).join('');let status=document.createElement('select');status.className='full';status.innerHTML='<option value="">印刷状態：すべて</option><option value="printed">印刷済み</option><option value="unprinted">未印刷</option>';let sort=document.createElement('select');sort.className='full';sort.innerHTML='<option value="new">作成日時：新しい順</option><option value="old">作成日時：古い順</option><option value="name">名前順</option>';let apply=()=>{let filtered=items.filter(q=>(!search.value||q.name.toLowerCase().includes(search.value.toLowerCase()))&&(!cat.value||q.category===cat.value)&&(!status.value||(status.value==='printed'?q.printed:!q.printed)));if(sort.value==='old')filtered.sort((a,b)=>new Date(a.createdAt)-new Date(b.createdAt));else if(sort.value==='name')filtered.sort((a,b)=>a.name.localeCompare(b.name,'ja'));else filtered.sort((a,b)=>new Date(b.createdAt)-new Date(a.createdAt));renderQRList(filtered,target,title)};search.oninput=apply;cat.onchange=apply;status.onchange=apply;sort.onchange=apply;el.append(search,cat,status,sort);let printPast=document.createElement('button');printPast.className='full';printPast.textContent='この一覧から印刷する';printPast.onclick=()=>{document.getElementById('printSelection').classList.remove('hidden');openPrintSelection()};el.appendChild(printPast)}if(!items.length){el.append('QRコードはありません。');return}items.forEach(q=>{let d=document.createElement('div');d.className='card';let h=document.createElement('h3');h.textContent=`${q.name}（${q.category}）`;let qr=document.createElement('div');qr.className='qr-image';new QRCode(qr,{text:qrUrl(q),width:180,height:180});let status=document.createElement('p');status.className='small';status.textContent=q.printed?'印刷済み':'未印刷';let edit=document.createElement('button');edit.textContent='名前・分類を変更';edit.onclick=()=>editQR(q.id);let del=document.createElement('button');del.textContent='完全削除';del.className='danger';del.onclick=()=>deleteQR(q.id);let print=document.createElement('button');print.textContent='印刷対象に選ぶ';print.onclick=()=>{document.getElementById('printSelection').classList.remove('hidden');openPrintSelection();let cb=document.querySelector(`#printChoices input[value="${q.id}"]`);if(cb)cb.checked=true};d.append(h,qr,status,edit,del,print);el.appendChild(d)})}
function editQR(id){let q=state.qrs.find(x=>x.id===id);if(!q)return;let p=document.getElementById('modalPanel');p.innerHTML=`<h2>QRコードの変更</h2><label>名前</label><input id="editName" value="${escapeHtml(q.name)}"><label>分類</label><select id="editCategory">${state.categories.map(c=>`<option ${c===q.category?'selected':''}>${escapeHtml(c)}</option>`).join('')}</select><button class="primary full" onclick="saveQRChange('${id}')">保存</button><button class="full" onclick="closeModal()">キャンセル</button>`;openModal()}
async function saveQRChange(id){let q=state.qrs.find(x=>x.id===id);if(!q)return;q.name=document.getElementById('editName').value.trim()||q.name;q.category=document.getElementById('editCategory').value;await saveState();closeModal();showQRs()}
async function deleteQR(id){if(!confirm('このQRコードは使用できなくなります。過去の記録は削除されません。完全削除しますか？'))return;let q=state.qrs.find(x=>x.id===id);if(q){q.deleted=true;q.deletedAt=new Date().toISOString()}await saveState();showQRs()}
function openPrintSelection(){let sec=document.getElementById('printSelection');sec.classList.remove('hidden');let choices=document.getElementById('printChoices');choices.innerHTML='';let items=showingPastQR?pastQRs():currentQRs();items.forEach(q=>{let l=document.createElement('label');l.className='print-choice';let cb=document.createElement('input');cb.type='checkbox';cb.value=q.id;let t=document.createElement('span');t.textContent=q.name+'（'+q.category+'）';l.append(cb,t);choices.appendChild(l)})}function closePrintSelection(){document.getElementById('printSelection').classList.add('hidden')}function selectLatest10(){let c=[...document.querySelectorAll('#printChoices input')];c.forEach((x,i)=>x.checked=i<10)}
async function printSelectedQRs(){let selected=[...document.querySelectorAll('#printChoices input:checked')].slice(0,10).map(x=>state.qrs.find(q=>q.id===x.value)).filter(Boolean);if(!selected.length)return alert('QRコードを選択してください');let canvas=document.createElement('canvas');canvas.width=1240;canvas.height=1754;let ctx=canvas.getContext('2d');ctx.fillStyle='white';ctx.fillRect(0,0,canvas.width,canvas.height);let margin=40,gap=20,cw=(canvas.width-2*margin-gap)/2,ch=(canvas.height-2*margin-gap*4)/5;for(let i=0;i<selected.length;i++){let q=selected[i],temp=document.createElement('div');new QRCode(temp,{text:qrUrl(q),width:350,height:350});let img=new Image();img.src=temp.querySelector('canvas').toDataURL();await new Promise(r=>img.onload=r);let x=margin+(i%2)*(cw+gap),y=margin+Math.floor(i/2)*(ch+gap);ctx.strokeStyle='#bbb';ctx.strokeRect(x,y,cw,ch);ctx.drawImage(img,x+(cw-260)/2,y+10,260,260);ctx.fillStyle='#12304a';ctx.font='bold 28px sans-serif';ctx.textAlign='center';ctx.fillText(q.name+'（'+q.category+'）',x+cw/2,y+305,cw-15);q.printed=true}await saveState();let blob=await new Promise(r=>canvas.toBlob(r,'image/png'));shareOrSave(blob,'QRコード_A4.png','QRコード印刷');showQRs()}
async function shareOrSave(blob,name,title){let file=new File([blob],name,{type:blob.type});if(navigator.canShare?.({files:[file]})&&navigator.share){try{await navigator.share({files:[file],title})}catch(e){if(e.name!=='AbortError')alert('共有できませんでした。ファイルに保存してください。')}}else{let a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1500)}}
function openDailyReport(){let p=document.getElementById('modalPanel');p.innerHTML='<h2>振り返りシート</h2><p>出力形式を選んでください。</p><button class="primary full" onclick="makeDailyReport(false)">A4・左右2列</button><button class="full" onclick="makeDailyReport(true)">細長い縦型・上下2段</button><button class="full" onclick="closeModal()">キャンセル</button>';openModal()}
async function makeDailyReport(vertical){
 let day=dateKey(selectedDate),logs=state.logs.filter(x=>x.date===day).sort((a,b)=>a.timestamp.localeCompare(b.timestamp));
 let studies=[];
 for(let i=0;i<logs.length;i++){if(logs[i].category==='勉強'){let next=logs.slice(i+1).find(x=>x.id!==logs[i].id);let mins=next?Math.max(0,Math.round((new Date(next.timestamp)-new Date(logs[i].timestamp))/60000)):0;studies.push({...logs[i],minutes:mins})}}
 let total=studies.reduce((a,x)=>a+x.minutes,0);
 const canvas=document.createElement('canvas');canvas.width=vertical?1240:1754;canvas.height=vertical?1754:1240;const ctx=canvas.getContext('2d');
 ctx.fillStyle='#ffffff';ctx.fillRect(0,0,canvas.width,canvas.height);ctx.fillStyle='#12304a';ctx.textBaseline='top';
 const margin=64,gap=48,colW=vertical?canvas.width-2*margin:(canvas.width-2*margin-gap)/2;
 function wrap(text,font,maxW){ctx.font=font;let lines=[];for(const para of String(text??'').split('\n')){let line='';for(const ch of para){if(line&&ctx.measureText(line+ch).width>maxW){lines.push(line);line=ch}else line+=ch}lines.push(line||'')}return lines}
 function drawSection(x,y,w,title){ctx.fillStyle='#12304a';ctx.font='bold 34px sans-serif';ctx.fillText(title,x,y);return y+58}
 function line(x,y,w){ctx.strokeStyle='#cbd5dc';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x+w,y);ctx.stroke()}
 ctx.font='bold 30px sans-serif';ctx.fillText(day,margin,margin);let y0=margin+56;
 function drawLeft(x,y,w){y=drawSection(x,y,w,'今日やったこと');ctx.font='bold 31px sans-serif';ctx.fillText('合計勉強時間：'+formatDuration(total),x,y);y+=55;line(x,y,w);y+=16;
  for(const item of studies){ctx.font='bold 25px sans-serif';let nameLines=wrap(item.name,'bold 25px sans-serif',w-190);nameLines.forEach(t=>{ctx.fillText(t,x,y);y+=34});ctx.font='bold 25px sans-serif';ctx.textAlign='right';ctx.fillText(formatDuration(item.minutes),x+w,y-34);ctx.textAlign='left';
   let memoLines=wrap(item.memo||'','20px sans-serif',w-20);ctx.font='20px sans-serif';ctx.fillStyle='#536777';memoLines.forEach(t=>{ctx.fillText(t,x,y);y+=28});ctx.fillStyle='#12304a';y+=7;line(x,y,w);y+=15;
  }return y}
 function drawRight(x,y,w){y=drawSection(x,y,w,'今日の一日');y+=4;for(const item of logs.filter(x=>['起床','就寝','勉強'].includes(x.category))){let time=new Date(item.timestamp).toLocaleTimeString('ja-JP',{hour:'2-digit',minute:'2-digit'});ctx.font='bold 24px sans-serif';ctx.fillText(time,x,y);y+=34;ctx.font='22px sans-serif';let lines=wrap(item.name+'（'+item.category+'）','22px sans-serif',w-12);lines.forEach(t=>{ctx.fillText(t,x,y);y+=30});line(x,y,w);y+=15}return y}
 if(vertical){let y=drawLeft(margin,y0,colW);drawRight(margin,y+35,colW)}else{drawLeft(margin,y0,colW);drawRight(margin+colW+gap,y0,colW)}
 const blob=await new Promise(resolve=>canvas.toBlob(resolve,'image/png'));if(!blob){alert('PNG画像を作成できませんでした。');return}
 shareOrSave(blob,`振り返り_${day}_${vertical?'縦型':'A4'}.png`,'振り返りシート');closeModal()
}
function showInfo(p){const texts={current:['記録の使い方','QRコードを読み取って日々の記録を残せます。今日・昨日の記録や合計勉強時間を確認できます。'],past:['過去の記録の使い方','年・月・週・日を順番に選んで、過去の記録を確認できます。'],qr:['QRコード作成の使い方','記録に使うQRコードを作成できます。印刷済みや作成から時間が経ったQRコードは「過去のQRコード」から確認できます。']};document.getElementById('infoTitle').textContent=texts[p][0];document.getElementById('infoContent').textContent=texts[p][1];document.getElementById('infoPopover').classList.remove('hidden')}
function closeInfo(){document.getElementById('infoPopover').classList.add('hidden')}
function openSettings(){settingsReturnPage=['current','past','qr'].find(p=>!document.getElementById(p+'Page').classList.contains('hidden'))||'current';switchPage('settings')}
function closeSettings(){switchPage(settingsReturnPage)}
function backupData(){let data={app:'QR記録アプリ',version:1,backupDate:new Date().toISOString(),qrs:state.qrs,logs:state.logs,categories:state.categories};let blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});shareOrSave(blob,`QR記録アプリ_バックアップ_${dateKey(new Date())}.json`,'バックアップ')}
function restoreData(){document.getElementById('restoreFile').click()}
async function restoreFromFile(e){let file=e.target.files[0];if(!file)return;try{let data=JSON.parse(await file.text());if(!data.qrs||!data.logs||!data.categories)throw Error('invalid');if(!confirm('現在のデータをバックアップ内容に置き換えます。復元前に現在のデータをバックアップしましたか？'))return;let old={qrs:state.qrs,logs:state.logs,categories:state.categories};let blob=new Blob([JSON.stringify({...old,backupDate:new Date().toISOString()},null,2)],{type:'application/json'});shareOrSave(blob,`復元前バックアップ_${dateKey(new Date())}.json`,'復元前バックアップ');state.qrs=data.qrs;state.logs=data.logs;state.categories=data.categories;await saveState();renderCategories();renderCurrent();showQRs();alert('復元しました。')}catch(err){alert('バックアップファイルを読み込めませんでした。')}e.target.value=''}
function exportExcel(){if(!window.XLSX)return alert('Excel出力ライブラリを読み込めませんでした。インターネット接続を確認してください。');let wb=XLSX.utils.book_new();let byMonth={};state.logs.forEach(x=>{let m=x.date.slice(0,7);(byMonth[m]??=[]).push(x)});Object.keys(byMonth).sort().forEach(m=>{let rows=[['日付','時刻','QRコード名','分類','メモ']];byMonth[m].sort((a,b)=>a.timestamp.localeCompare(b.timestamp)).forEach(x=>rows.push([x.date,new Date(x.timestamp).toLocaleTimeString('ja-JP',{hour:'2-digit',minute:'2-digit'}),x.name,x.category||'未分類',x.memo||'']));let ws=XLSX.utils.aoa_to_sheet(rows);ws['!cols']=[{wch:14},{wch:10},{wch:28},{wch:14},{wch:40}];XLSX.utils.book_append_sheet(wb,ws,m.replace('-','年')+'月')});if(!Object.keys(byMonth).length)XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet([['記録はありません']]),'記録');let bytes=XLSX.write(wb,{bookType:'xlsx',type:'array'});shareOrSave(new Blob([bytes],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'}),`QR記録_${dateKey(new Date())}.xlsx`,'Excel記録')}
function openModal(){document.getElementById('modal').classList.remove('hidden')}function closeModal(){document.getElementById('modal').classList.add('hidden')}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function openScanMode(){document.getElementById('scanModal').classList.remove('hidden')}function closeScanner(){stopCamera();document.getElementById('scanModal').classList.add('hidden');document.getElementById('scannerArea').classList.add('hidden');switchPage('current')}
async function startScanner(mode){scanMode=mode;document.querySelectorAll('[data-scanmode]').forEach(b=>b.classList.toggle('selected',b.dataset.scanmode===mode));document.getElementById('scannerArea').classList.remove('hidden');let msg=document.getElementById('scanMessage');try{cameraStream=await navigator.mediaDevices.getUserMedia({video:{facingMode:{ideal:'environment'}},audio:false});let v=document.getElementById('scanVideo');v.srcObject=cameraStream;await v.play();if(!('BarcodeDetector'in window)){msg.textContent='このブラウザは画面内QR読み取りに対応していません。スマホのカメラで読み取ってください。';return}let detector=new BarcodeDetector({formats:['qr_code']});let tick=async()=>{if(!cameraStream)return;try{let codes=await detector.detect(v);if(codes.length){let id=null;try{id=new URL(codes[0].rawValue).searchParams.get('scan')}catch{}if(id){stopCamera();closeScanner();if(scanMode==='record')recordScan(id);else if(scanMode==='search')findLastRecord(id);else editQR(id)}else msg.textContent='このQRコードはアプリのものではありません。';return}}catch{}scanLoop=requestAnimationFrame(tick)};tick()}catch(e){msg.textContent='カメラを起動できませんでした。カメラの使用を許可してください。'}}function stopCamera(){if(scanLoop)cancelAnimationFrame(scanLoop);scanLoop=null;if(cameraStream){cameraStream.getTracks().forEach(t=>t.stop());cameraStream=null}let v=document.getElementById('scanVideo');if(v)v.srcObject=null}
async function recordScan(id){let q=state.qrs.find(x=>x.id===id&&!x.deleted);if(!q){alert('このQRコードは削除済み、または登録されていません。');return}let memo=prompt('記録にメモを追加しますか？（空欄でも記録できます）','');let now=new Date();state.logs.push({logId:crypto.randomUUID(),id:q.id,name:q.name,category:q.category,timestamp:now.toISOString(),date:dateKey(now),memo:memo||''});await saveState();selectedDate=new Date(now.getFullYear(),now.getMonth(),now.getDate());selectedHour=now.getHours();switchPage('current');renderCurrent()}
function findLastRecord(id){let logs=state.logs.filter(x=>x.id===id).sort((a,b)=>b.timestamp.localeCompare(a.timestamp));if(!logs.length)return alert('このQRコードの記録はまだありません');let d=new Date(logs[0].timestamp);selectedDate=new Date(d.getFullYear(),d.getMonth(),d.getDate());selectedHour=d.getHours();switchPage('current');renderCurrent()}
function checkURL(){let id=new URLSearchParams(location.search).get('scan');if(id){recordScan(id);history.replaceState(null,'',location.pathname)}}
function renderArchive(){let path=document.getElementById('archivePath'),list=document.getElementById('archiveList'),detail=document.getElementById('archiveDetail');path.innerHTML='';list.innerHTML='';detail.innerHTML='';let years=[...new Set(state.logs.map(x=>x.date.slice(0,4)))].sort().reverse();if(!archiveYear){years.forEach(y=>addArchiveItem(list,y,()=>{archiveYear=y;renderArchive()}));return}addPathButton(path,'年一覧',()=>{archiveYear=null;archiveMonth=null;archiveWeek=null;archiveDay=null;renderArchive()});if(!archiveMonth){[...new Set(state.logs.filter(x=>x.date.startsWith(archiveYear)).map(x=>x.date.slice(0,7)))].sort().reverse().forEach(m=>addArchiveItem(list,m.slice(5)+'月',()=>{archiveMonth=m;renderArchive()}));return}addPathButton(path,archiveYear,()=>{archiveMonth=null;archiveWeek=null;archiveDay=null;renderArchive()});addPathButton(path,archiveMonth.slice(5)+'月',()=>{archiveWeek=null;archiveDay=null;renderArchive()});let monthLogs=state.logs.filter(x=>x.date.startsWith(archiveMonth));let weekMap={};monthLogs.forEach(x=>{let d=parseDate(x.date),s=addDays(d,-((d.getDay()+6)%7)),e=addDays(s,6),key=String(s.getDate()).padStart(2,'0')+'-'+String(e.getDate()).padStart(2,'0');(weekMap[key]??=[]).push(x.date)});if(!archiveWeek){Object.keys(weekMap).forEach(w=>addArchiveItem(list,w,()=>{archiveWeek=w;renderArchive()}));return}addPathButton(path,archiveWeek,()=>{archiveWeek=null;archiveDay=null;renderArchive()});[...new Set(weekMap[archiveWeek]||[])].sort().forEach(d=>addArchiveItem(list,d.slice(8)+'日',()=>{archiveDay=d;renderArchive()}));if(!archiveDay)return;addPathButton(path,archiveDay,()=>{archiveDay=null;renderArchive()});let logs=state.logs.filter(x=>x.date===archiveDay).sort((a,b)=>a.timestamp.localeCompare(b.timestamp));logs.forEach(x=>{let div=document.createElement('div');div.className='card';div.textContent=new Date(x.timestamp).toLocaleTimeString('ja-JP',{hour:'2-digit',minute:'2-digit'})+'　'+x.name+'（'+x.category+'）'+(x.memo?'\nメモ：'+x.memo:'');detail.appendChild(div)});let txt=logs.map(x=>new Date(x.timestamp).toLocaleTimeString('ja-JP',{hour:'2-digit',minute:'2-digit'})+' '+x.name+'（'+x.category+'）'+(x.memo?' メモ:'+x.memo:'')).join('\n');let b=document.createElement('button');b.className='primary full';b.textContent='この日の記録をテキスト保存';b.onclick=()=>shareOrSave(new Blob([archiveDay+'\n'+txt],{type:'text/plain;charset=utf-8'}),archiveDay+'.txt','記録テキスト');detail.appendChild(b)}function addArchiveItem(parent,label,fn){let b=document.createElement('button');b.className='archive-item full';b.textContent=label+'　開く ›';b.onclick=fn;parent.appendChild(b)}function addPathButton(parent,label,fn){let b=document.createElement('button');b.textContent=label;b.onclick=fn;parent.appendChild(b)}
function init(){initDB().catch(e=>alert('データベースを開けませんでした。HTTPSで開いているか確認してください。'))}init();
</script></body></html>
